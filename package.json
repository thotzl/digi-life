{
  "name": "digi-life",
  "private": true,
  "version": "1.7.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "tauri:dev": "tauri dev",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "sim:balance": "cargo run --bin cli_trainer --manifest-path src-tauri/Cargo.toml",
    "types:generate": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:all": "npm run test && npm run test:rust && cargo check --bin cli_trainer --manifest-path src-tauri/Cargo.toml",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^1.6.0",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.12",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "@preact/signals-core": "^1.14.4",
    "@tauri-apps/api": "^2.11.1",
    "ws": "^8.21.3",
    "zustand": "^5.0.15"
  }
}
