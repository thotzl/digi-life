{
  "name": "digi-life",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev:client": "vite",
    "dev:server": "tsx src/server/index.ts",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"npm run dev:server\" \"npm run dev:client\"",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^8.2.0",
    "@stryker-mutator/vitest-runner": "^8.2.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.11",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.12",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@preact/signals-core": "^1.14.4",
    "better-sqlite3": "^11.0.0",
    "ws": "^8.21.3",
    "zustand": "^5.0.15"
  }
}
