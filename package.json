{
  "name": "digi-life",
  "private": true,
  "version": "1.12.20",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "tauri:dev": "tauri dev",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:rust": "cargo test",
    "sim:balance": "cargo run --release --bin trainer_runner -- run --seed baseline --generations 20 --scenario standard --population 16 --parallel true --out .agents/artifacts/runner/balance.json",
    "types:generate": "cargo test",
    "test:all": "npm run test && npm run test:rust && cargo check --bin trainer_runner",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@tauri-apps/cli": "^2.11.4",
    "@vitest/coverage-v8": "^1.6.0",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.12",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "@preact/signals-core": "^1.14.4",
    "@tauri-apps/api": "^2.11.1"
  }
}
