{
  "productName": "Pixel DNA Life",
  "version": "1.3.3",
  "identifier": "com.pixeldna.life",
  "build": {
    "beforeDevCommand": "npm run dev:client",
    "devUrl": "http://localhost:3000/tauri_ocean.html",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Pixel DNA Life - Evolution Laboratory",
        "width": 1280,
        "height": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/icon.png"
    ]
  }
}
